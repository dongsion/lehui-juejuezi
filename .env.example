# ============================================================
# 生产环境配置模板
# ============================================================
# 使用方法：
#   cp .env.example .env
#   修改下面的值后运行 docker compose up -d --build
# ============================================================

# 商家端管理令牌（登录 /admin 时的密码）
# 生产环境务必改成复杂字符串！
OWNER_TOKEN=baji-owner-2026

# 对外暴露的 Web 端口（默认 80）
# 如服务器 80 被占用，可改为 8080 等
WEB_PORT=80

# ===== 以下为真实支付对接时配置（当前 Mock 模式可留空）=====

# 微信支付商户配置（开通 H5 支付后填入）
# WECHAT_MCHID=          # 商户号
# WECHAT_APPID=          # 公众号或小程序 AppID
# WECHAT_PRIVATE_KEY=    # 商户 API 私钥
# WECHAT_SERIAL_NO=      # 证书序列号
# WECHAT_API_V3_KEY=     # APIv3 密钥
# WECHAT_NOTIFY_URL=     # 支付回调地址 https://你的域名/api/payment/callback/wechat

# 支付宝配置（开通手机网站支付后填入）
# ALIPAY_APP_ID=          # 应用 APPID
# ALIPAY_PRIVATE_KEY=     # 应用私钥
# ALIPAY_PUBLIC_KEY=       # 支付宝公钥
# ALIPAY_NOTIFY_URL=      # 支付回调地址 https://你的域名/api/payment/callback/alipay
